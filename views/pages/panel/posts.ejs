<div class="row">
  <div class="col-lg-12 d-flex align-items-stretch">
    <div class="card w-100">
      <div class="card-body p-4">
        <%if(success_message){%>
        <div class="alert alert-success text-center" role="alert">
          <%=success_message%>
        </div>
        <%}%>
        <div class="d-flex align-items-center justify-content-between mb-3">
          <h5 class="card-title fw-semibold mb-2">آگهی های من</h5>
          <div>
            <a href="/post/create" class="btn btn-primary">افزودن آگهی</a>
          </div>
        </div>
        <div class="table-responsive">
          <table class="table text-nowrap mb-0 align-middle">
            <thead class="text-dark fs-4">
              <tr>
                <th class="border-bottom-0">
                  <h6 class="fw-semibold mb-0">شناسه</h6>
                </th>
                <th class="border-bottom-0">
                  <h6 class="fw-semibold mb-0">عنوان</h6>
                </th>
                <th class="border-bottom-0">
                  <h6 class="fw-semibold mb-0">توضیحات</h6>
                </th>
                <th class="border-bottom-0">
                  <h6 class="fw-semibold mb-0">تاریخ انتشار</h6>
                </th>
                <th class="border-bottom-0">
                  <h6 class="fw-semibold mb-0">عملیات</h6>
                </th>
              </tr>
            </thead>

            <tbody>
              <%if(posts.length == 0){%>
              <div class="alert alert-danger text-center" role="alert">
                شما هیچ آگهی ثبت نکردید.
              </div>
              <%}%> <%posts.forEach(post => {%>
              <tr>
                <td class="border-bottom-0">
                  <h6 class="fw-semibold mb-0"><%=post._id%></h6>
                </td>
                <td class="border-bottom-0">
                  <h6 class="fw-semibold mb-0"><%=post.title%></h6>
                </td>
                <td class="border-bottom-0">
                  <h6 class="fw-semibold mb-0"><%=post.content%></h6>
                </td>
                <td class="border-bottom-0">
                  <h6 class="fw-semibold mb-0">
                    <%=moment(post.createdAt).locale("fa").format("jDD-jMMMM-jYYYY")
                    %>
                  </h6>
                </td>
                <td class="border-bottom-0">
                  <h6 class="fw-semibold mb-0">
                    <form
                      class="d-inline"
                      action="/post/delete/<%=post._id%>?_method=delete"
                      method="post"
                    >
                      <button
                        type="submit"
                        class="btn btn-danger"
                        onclick="alert('از حذف آگهی مطمئن هستید؟')"
                      >
                        حذف
                      </button>
                    </form>
                    <a href="/post/<%=post._id%>" class="btn btn-success"
                      >مشاهده</a
                    >
                  </h6>
                </td>

                <%})%>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
